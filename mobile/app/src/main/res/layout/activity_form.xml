<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentDescription="Назад"
            android:layout_marginTop="20dp"
            app:srcCompat="@drawable/btn_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Заявка на возврат"
            android:textColor="#000000"
            android:textSize="22sp"
            android:fontFamily="@font/fredoka_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <TextView
            android:id="@+id/labelFio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ФИО"
            android:textColor="#000000"
            android:textSize="18sp"
            android:fontFamily="@font/jetbrainsmono_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTitle" />

        <EditText
            android:id="@+id/etFio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="14dp"
            android:hint="Иванов Иван Иванович"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:fontFamily="@font/fredoka_regular"
            android:textSize="16sp"
            android:inputType="textPersonName"
            android:imeOptions="actionNext"
            app:layout_constraintTop_toBottomOf="@id/labelFio" />

        <TextView
            android:id="@+id/labelGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Группа"
            android:textColor="#000000"
            android:textSize="18sp"
            android:fontFamily="@font/jetbrainsmono_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etFio" />

        <EditText
            android:id="@+id/etGroup"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="14dp"
            android:hint="Python-1"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:fontFamily="@font/fredoka_regular"
            android:textSize="16sp"
            android:inputType="text"
            android:imeOptions="actionNext"
            app:layout_constraintTop_toBottomOf="@id/labelGroup" />

        <TextView
            android:id="@+id/labelTeacher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Преподаватель"
            android:textColor="#000000"
            android:textSize="18sp"
            android:fontFamily="@font/jetbrainsmono_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etGroup" />

        <EditText
            android:id="@+id/etTeacher"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search"
            android:paddingHorizontal="14dp"
            android:hint="Петров Пётр Петрович"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:fontFamily="@font/fredoka_regular"
            android:textSize="16sp"
            android:inputType="textPersonName"
            android:imeOptions="actionDone"
            app:layout_constraintTop_toBottomOf="@id/labelTeacher" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#9FCFEC"
            android:fontFamily="@font/jetbrainsmono_bold"
            android:paddingVertical="16dp"
            android:text="Отправить"
            android:textColor="#000000"
            android:textSize="20sp"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/etTeacher"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
