<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgLostThing"
            android:layout_width="match_parent"
            android:layout_height="306dp"
            android:background="#9FCFEC"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#80FFFFFF"
            android:contentDescription="Назад"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            app:srcCompat="@drawable/btn_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Badges on top of content -->
        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/imgLostThing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/badgeType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/badge_found_bg"
                android:fontFamily="@font/jetbrainsmono_bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="НАХОДКА"
                android:textColor="@color/badge_found"
                android:textSize="12sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/badgeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/status_active_bg"
                android:fontFamily="@font/jetbrainsmono_bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="ИЩЕТ ВЛАДЕЛЬЦА"
                android:textColor="@color/status_active"
                android:textSize="12sp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/badgeCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#F1F5F9"
                android:fontFamily="@font/jetbrainsmono_semibold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="👟 Одежда"
                android:textColor="#334155"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelOpisanie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/jetbrainsmono_semibold"
            android:text="Описание:"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutBadges" />

        <TextView
            android:id="@+id/txtOpisanie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/fredoka_regular"
            android:textColor="#333333"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelOpisanie" />

        <TextView
            android:id="@+id/labelPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/jetbrainsmono_semibold"
            android:text="Место:"
            android:textColor="#000000"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtOpisanie" />

        <TextView
            android:id="@+id/txtPlace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/fredoka_regular"
            android:textColor="#333333"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelPlace" />

        <!-- Innovation: Safe Handover Code Card -->
        <LinearLayout
            android:id="@+id/cardHandover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#F0F9FF"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtPlace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtHandoverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrainsmono_bold"
                android:text="🔒 Безопасная передача вещи"
                android:textColor="#0369A1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtAuthorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jetbrainsmono_semibold"
                android:text="👤 Автор объявления: Дежурный"
                android:textColor="#0284C7"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtCodePrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/fredoka_regular"
                android:text="Проверочный код:"
                android:textColor="#0C4A6E"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtReturnCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#BAE6FD"
                android:fontFamily="@font/jetbrainsmono_bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="4 8 2 1"
                android:textColor="#0369A1"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtAuthorNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#E0F2FE"
                android:padding="10dp"
                android:fontFamily="@font/fredoka_regular"
                android:text="ℹ️ Вы разместили это объявление. Назовите этот проверочный код получателю при личной передаче вещи. Получатель введёт его в своём приложении для подтверждения возврата."
                android:textColor="#0369A1"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#0284C7"
                android:fontFamily="@font/jetbrainsmono_bold"
                android:text="Ввести код от автора"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- P2P Chat Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/brand_blue"
            android:fontFamily="@font/jetbrainsmono_bold"
            android:paddingVertical="14dp"
            android:text="💬 Написать в чат"
            android:textColor="#000000"
            android:textSize="16sp"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/cardHandover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Claim button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#FFFFFF"
            android:fontFamily="@font/jetbrainsmono_semibold"
            android:paddingVertical="12dp"
            android:text="Заявить о вещи дежурному"
            android:textColor="#4B5563"
            android:textSize="14sp"
            app:strokeColor="#D1D5DB"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnChat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

