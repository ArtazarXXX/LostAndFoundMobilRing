<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="15dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="0dp">

    <ImageView
        android:id="@+id/imgItem"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_image_placeholder"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Badges overlay on top of image -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="@id/imgItem"
        app:layout_constraintStart_toStartOf="@id/imgItem"
        app:layout_constraintEnd_toEndOf="@id/imgItem">

        <!-- Type badge (Находка / Пропажа) -->
        <TextView
            android:id="@+id/badgeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/badge_found_bg"
            android:fontFamily="@font/jetbrainsmono_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="НАХОДКА"
            android:textColor="@color/badge_found"
            android:textSize="11sp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <!-- Status badge (Ищет владельца / Возвращено) -->
        <TextView
            android:id="@+id/badgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/status_active_bg"
            android:fontFamily="@font/jetbrainsmono_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="ИЩЕТ ВЛАДЕЛЬЦА"
            android:textColor="@color/status_active"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Category tag & Date -->
    <LinearLayout
        android:id="@+id/layoutMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/imgItem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrainsmono_semibold"
            android:text="👟 Сменка и одежда"
            android:textColor="#2563EB"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#9CA3AF" />

        <TextView
            android:id="@+id/txtDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_regular"
            android:text="Сегодня"
            android:textColor="#6B7280"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPlace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/jetbrainsmono_semibold"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/layoutMeta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Кабинет 204" />

    <TextView
        android:id="@+id/txtComment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/fredoka_regular"
        android:textColor="#444444"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/txtPlace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Чёрный рюкзак с наклейкой Python" />

</androidx.constraintlayout.widget.ConstraintLayout>

